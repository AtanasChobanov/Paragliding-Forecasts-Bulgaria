{
  "name": "@paragliding-forecasts/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API for Paragliding Forecasts Bulgaria.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "contracts:build": "npm --prefix ../.. run build --workspace @paragliding-forecasts/contracts",
    "dev": "tsx watch src/main.ts",
    "prebuild": "npm run contracts:build",
    "predev": "npm run contracts:build",
    "pretest": "npm run contracts:build",
    "pretest:watch": "npm run contracts:build",
    "pretypecheck": "npm run contracts:build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@paragliding-forecasts/contracts": "^0.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1"
  }
}
