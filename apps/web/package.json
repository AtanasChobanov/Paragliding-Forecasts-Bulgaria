{
  "name": "@paragliding-forecasts/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React dashboard for Paragliding Forecasts Bulgaria.",
  "scripts": {
    "build": "npm run typecheck:raw && vite build",
    "contracts:build": "npm --prefix ../.. run build --workspace @paragliding-forecasts/contracts",
    "dev": "npm run dev:raw",
    "dev:raw": "vite",
    "prebuild": "npm run contracts:build",
    "predev": "npm run contracts:build",
    "pretest": "npm run contracts:build",
    "pretest:coverage": "npm run contracts:build",
    "pretest:watch": "npm run contracts:build",
    "pretypecheck": "npm run contracts:build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "npm run typecheck:raw",
    "typecheck:raw": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@paragliding-forecasts/contracts": "^0.1.0",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "sass-embedded": "^1.100.0",
    "vite": "^8.1.5"
  }
}
