# Runtime
NODE_ENV=development
# Local development opts into verbose logs; the API schema defaults to info.
LOG_LEVEL=debug

# Local applications. If WEB_PORT changes, CORS_ORIGIN must use the same
# dashboard scheme, host, and port.
WEB_PORT=5173
API_HOST=127.0.0.1
API_PORT=3000
VITE_API_BASE_URL=http://127.0.0.1:3000
CORS_ORIGIN=http://localhost:5173

# MVP persistence and model artifacts
DATABASE_URL=file:./data/local/paragliding.db
MODEL_ARTIFACT_DIR=./data/models

# Until real forecast ingestion is implemented, the UI/API must expose this
# status explicitly rather than presenting mock values as real forecasts.
FORECAST_DATA_MODE=mock
