# Generated or locally acquired data. Keep only the directory markers.
raw/*
!raw/.gitkeep
external/*
!external/.gitkeep
interim/*
!interim/.gitkeep
processed/*
!processed/.gitkeep
models/*
!models/.gitkeep
local/*
!local/.gitkeep

