      "nullable_field_codes": ["provider_cloud_base_agl_m", "convective_inhibition_magnitude_j_per_kg", "wind_direction_degrees_from_north"],
      "max_terrain_mismatch_m": 2500,
      "max_point_grid_distance_km": 50
    },
    "copernicus_era5": {
