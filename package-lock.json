{
  "name": "paragliding-forecasts-bulgaria",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "paragliding-forecasts-bulgaria",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=24 <25",
        "npm": ">=11 <12"
      }
    },
    "apps/api": {
      "name": "@paragliding-forecasts/api",
      "version": "0.1.0"
    },
    "apps/web": {
      "name": "@paragliding-forecasts/web",
      "version": "0.1.0"
    },
    "node_modules/@paragliding-forecasts/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@paragliding-forecasts/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@paragliding-forecasts/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/contracts": {
      "name": "@paragliding-forecasts/contracts",
      "version": "0.1.0"
    }
  }
