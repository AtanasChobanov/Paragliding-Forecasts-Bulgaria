{
  "name": "@paragliding-forecasts/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle-owned SQLite schema and migration boundary for paragliding flight data.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "rc"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "drizzle-kit": "rc",
    "tsx": "^4.23.1"
  }
}
