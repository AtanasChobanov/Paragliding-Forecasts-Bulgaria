    },
    {
      "value": "length(\"code\") BETWEEN 1 AND 80\n        AND substr(\"code\", 1, 1) GLOB '[a-z]'\n        AND \"code\" NOT GLOB '*[^a-z0-9_]*'\n        AND \"code\" NOT GLOB '*__*'\n        AND substr(\"code\", -1) <> '_'",
