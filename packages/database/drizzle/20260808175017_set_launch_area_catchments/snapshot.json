      "entityType": "checks",
      "table": "ingestion_runs"
    },
    {
      "value": "\"permission_basis\" IN (\n        'written_permission',\n        'source_terms',\n        'owner_export',\n        'official_api_terms',\n        'pilot_provided'\n      )",
      "name": "ingestion_runs_permission_basis_check",
      "entityType": "checks",
      "table": "ingestion_runs"
    },
    {
      "value": "length(trim(\"permission_reference\")) > 0",
      "name": "ingestion_runs_permission_reference_non_empty_check",
      "entityType": "checks",
      "table": "ingestion_runs"
    },
    {
      "value": "\"model_training_allowed\" IN (0, 1)",
      "name": "ingestion_runs_model_training_allowed_boolean_check",
      "entityType": "checks",
      "table": "ingestion_runs"
    },
    {
      "value": "\"operational_use_allowed\" IN (0, 1)",
      "name": "ingestion_runs_operational_use_allowed_boolean_check",
      "entityType": "checks",
      "table": "ingestion_runs"
    },
    {
      "value": "\"raw_manifest_path\" LIKE 'data/raw/%' AND \"raw_manifest_path\" NOT LIKE '%..%'",
      "name": "ingestion_runs_raw_manifest_path_check",
      "entityType": "checks",
      "table": "ingestion_runs"
    },
    {
      "value": "length(\"raw_manifest_sha256\") = 64\n        AND \"raw_manifest_sha256\" NOT GLOB '*[^0-9a-f]*'",
      "name": "ingestion_runs_raw_manifest_sha256_check",
      "entityType": "checks",
      "table": "ingestion_runs"
    },
    {
      "value": "length(trim(\"pipeline_version\")) > 0",
