    },
    {
      "value": "\"created_at_utc\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z'",
      "name": "flight_records_created_at_utc_shape_check",
