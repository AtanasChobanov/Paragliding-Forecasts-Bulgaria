      "table": "ingestion_runs"
    },
    {
      "value": "\"started_at_utc\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z'",
      "name": "ingestion_runs_started_at_utc_shape_check",
      "entityType": "checks",
      "table": "ingestion_runs"
    },
    {
      "value": "\"completed_at_utc\" IS NULL\n        OR \"completed_at_utc\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z'",
      "name": "ingestion_runs_completed_at_utc_shape_check",
      "entityType": "checks",
      "table": "ingestion_runs"
    },
    {
      "value": "(\n          \"status\" = 'running'\n          AND \"completed_at_utc\" IS NULL\n        )\n        OR (\n          \"status\" IN ('succeeded', 'failed')\n          AND \"completed_at_utc\" IS NOT NULL\n          AND \"completed_at_utc\" >= \"started_at_utc\"\n        )",
      "name": "ingestion_runs_completion_lifecycle_check",
      "entityType": "checks",
      "table": "ingestion_runs"
    },
    {
      "value": "\"records_seen\" >= 0\n        AND \"records_accepted\" >= 0\n        AND \"records_rejected\" >= 0\n        AND \"records_quarantined\" >= 0\n        AND \"records_deduplicated\" >= 0",
      "name": "ingestion_runs_counters_non_negative_check",
      "entityType": "checks",
      "table": "ingestion_runs"
    },
    {
      "value": "\"records_accepted\" + \"records_rejected\" + \"records_quarantined\"\n        <= \"records_seen\"",
      "name": "ingestion_runs_counter_outcomes_check",
      "entityType": "checks",
      "table": "ingestion_runs"
    },
    {
      "value": "length(\"slug\") BETWEEN 1 AND 80\n        AND substr(\"slug\", 1, 1) GLOB '[a-z0-9]'\n        AND \"slug\" NOT GLOB '*[^a-z0-9-]*'\n        AND \"slug\" NOT GLOB '*--*'\n        AND substr(\"slug\", -1) <> '-'",
