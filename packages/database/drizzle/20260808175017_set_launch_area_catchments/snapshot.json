      "entityType": "checks",
      "table": "sites"
    },
    {
      "value": "\"longitude_deg\" BETWEEN -180 AND 180",
      "name": "sites_longitude_deg_range_check",
      "entityType": "checks",
      "table": "sites"
    },
    {
      "value": "\"catchment_radius_km\" IS NULL\n        OR (\"catchment_radius_km\" > 0 AND \"catchment_radius_km\" <= 250)",
      "name": "sites_catchment_radius_km_range_check",
      "entityType": "checks",
      "table": "sites"
    },
    {
      "value": "length(trim(\"time_zone\")) > 0",
      "name": "sites_time_zone_non_empty_check",
      "entityType": "checks",
      "table": "sites"
    },
    {
      "value": "\"is_active\" IN (0, 1)",
      "name": "sites_is_active_boolean_check",
      "entityType": "checks",
      "table": "sites"
    },
    {
      "value": "\"key_type\" IN (\n        'source_takeoff_id',\n        'source_site_token',\n        'normalized_name',\n        'source_point'\n      )",
      "name": "source_site_mappings_key_type_check",
      "entityType": "checks",
      "table": "source_site_mappings"
    },
    {
      "value": "(\n          \"key_type\" IN ('source_takeoff_id', 'source_site_token', 'normalized_name')\n          AND \"key_value\" IS NOT NULL\n          AND length(trim(\"key_value\")) > 0\n          AND \"point_latitude_deg\" IS NULL\n          AND \"point_longitude_deg\" IS NULL\n        )\n        OR (\n          \"key_type\" = 'source_point'\n          AND \"key_value\" IS NULL\n          AND \"point_latitude_deg\" IS NOT NULL\n          AND \"point_longitude_deg\" IS NOT NULL\n        )",
      "name": "source_site_mappings_key_shape_check",
      "entityType": "checks",
      "table": "source_site_mappings"
    },
    {
      "value": "\"point_latitude_deg\" IS NULL\n        OR \"point_latitude_deg\" BETWEEN -90 AND 90",
