      "table": "source_site_mappings"
    },
    {
      "value": "\"point_longitude_deg\" IS NULL\n        OR \"point_longitude_deg\" BETWEEN -180 AND 180",
      "name": "source_site_mappings_point_longitude_deg_range_check",
      "entityType": "checks",
      "table": "source_site_mappings"
    },
    {
      "value": "\"status\" IN ('provisional', 'approved', 'retired')",
      "name": "source_site_mappings_status_check",
      "entityType": "checks",
      "table": "source_site_mappings"
    },
    {
      "value": "\"verified_at_utc\" IS NULL OR \"verified_at_utc\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z'",
      "name": "source_site_mappings_verified_at_utc_shape_check",
      "entityType": "checks",
      "table": "source_site_mappings"
    },
    {
      "value": "\"status\" <> 'approved'\n        OR (\n          \"verification_reference\" IS NOT NULL\n          AND length(trim(\"verification_reference\")) > 0\n          AND \"verified_at_utc\" IS NOT NULL\n        )",
      "name": "source_site_mappings_approved_evidence_check",
      "entityType": "checks",
      "table": "source_site_mappings"
