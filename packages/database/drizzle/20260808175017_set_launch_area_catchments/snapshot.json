    },
    {
      "value": "\"ingestion_method\" IN (\n        'manual_export',\n        'owner_export',\n        'official_api',\n        'authorized_http',\n        'pilot_provided'\n      )",
      "name": "ingestion_runs_ingestion_method_check",
